{
  "_说明": "复合任务库 - 管理需要多步骤、长时间跨度才能完成的复杂行为链。如攒钱买玫瑰花",
  "_版本": "1.0",
  "_使用方式": "每条任务 = 触发条件 + 步骤链 + 成功/失败条件。引擎检测触发条件后自动推进步骤",

  "任务定义": [
    {
      "任务id": "quest_earn_money_for_rose",
      "名称": "攒钱买玫瑰花",
      "描述": "被齐琳琳拒绝后，乐观的云飞决定攒钱送更好的礼物",
      "触发条件": {
        "且": [
          { "记忆标签": ["包含", "被齐琳琳拒绝礼物"] },
          { "性格.乐观": [">=", 5] },
          { "金钱": ["<", 100] }
        ]
      },
      "步骤链": [
        {
          "步骤": 1,
          "名称": "查看可接任务",
          "动作": "action_seek_job",
          "说明": "去布告栏或找能发布任务的NPC"
        },
        {
          "步骤": 2,
          "名称": "打工攒钱",
          "动作": "action_工作",
          "循环条件": { "金钱": ["<", 100] },
          "说明": "重复打工直到钱够买玫瑰"
        },
        {
          "步骤": 3,
          "名称": "去花店买玫瑰",
          "动作": "action_购物",
          "参数": { "目标商店": "flower_shop", "目标物品": "玫瑰花" },
          "说明": "去云香花店买玫瑰花"
        },
        {
          "步骤": 4,
          "名称": "送玫瑰花",
          "动作": "action_送礼",
          "参数": { "目标NPC": "齐琳琳" },
          "说明": "找到齐琳琳并送上玫瑰花"
        }
      ],
      "失败条件": [
        { "性格.乐观": ["<=", 3] },
        { "目标NPC不存在": true }
      ],
      "成功条件": {
        "且": [
          { "拥有玫瑰花": true },
          { "已送出": true }
        ]
      }
    },

    {
      "任务id": "quest_help_merchant",
      "名称": "帮商人打工",
      "描述": "去商店帮老板干活赚钱",
      "触发条件": {
        "且": [
          { "金钱": ["<", 30] },
          { "性格.勤奋": [">=", 4] }
        ]
      },
      "步骤链": [
        {
          "步骤": 1,
          "名称": "找雇主",
          "动作": "action_seek_job",
          "说明": "找到能提供任务的商人NPC"
        },
        {
          "步骤": 2,
          "名称": "完成指定工作",
          "动作": "$雇主发布的任务",
          "说明": "执行雇主给的工作指令"
        },
        {
          "步骤": 3,
          "名称": "领取报酬",
          "动作": "action_receive_payment",
          "说明": "从雇主处领取金钱报酬"
        }
      ],
      "成功条件": { "任务完成": true },
      "失败条件": { "雇主不可用": true }
    },

    {
      "任务id": "quest_find_shop",
      "名称": "寻找商店",
      "描述": "打听并找到某个商店的位置",
      "触发条件": {
        "且": [
          { "知识库.水果店": ["==", null] }
        ]
      },
      "步骤链": [
        {
          "步骤": 1,
          "名称": "向路人打听",
          "动作": "action_ask_direction",
          "参数": { "询问内容": "水果店位置" }
        },
        {
          "步骤": 2,
          "名称": "前往商店",
          "动作": "action_follow_direction",
          "说明": "按路人指的方向走"
        },
        {
          "步骤": 3,
          "名称": "记忆位置",
          "动作": "action_learn_location",
          "说明": "把商店坐标写入知识库"
        }
      ],
      "成功条件": { "知识库.水果店": ["!=", null] }
    },

    {
      "任务id": "quest_pursue_npc",
      "名称": "追求NPC",
      "描述": "看到高颜值NPC后展开追求攻势",
      "触发条件": {
        "且": [
          { "性格.好色": [">=", 5] },
          { "感知.看到高颜值NPC": ["==", true] }
        ]
      },
      "步骤链": [
        {
          "步骤": 1,
          "名称": "搭讪",
          "动作": "action_搭讪"
        },
        {
          "步骤": 2,
          "名称": "等待回应",
          "动作": "action_wait_response",
          "说明": "等对方回应，根据回应决定下一步",
          "分支": {
            "接受": { "下一步": "步骤3_聊天" },
            "拒绝": {
              "且": { "性格.乐观": [">=", 5] },
              "下一步": "步骤3_送礼",
              "否则": "结束"
            }
          }
        },
        {
          "步骤": "3_聊天",
          "名称": "深入聊天",
          "动作": "action_greet"
        },
        {
          "步骤": "3_送礼",
          "名称": "准备礼物挽回",
          "动作": "action_送礼"
        }
      ],
      "成功条件": { "对方接受": true },
      "失败条件": { "被拒绝两次": true }
    }
  ]
}
