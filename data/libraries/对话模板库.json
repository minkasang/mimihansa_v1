{
  "_说明": "对话模板库 - 所有NPC对话的模板集合。运行时根据场景和人物关系动态选择",
  "_版本": "2.0",
  "_使用方式": "通过template_id引用，支持变量替换如{name}、{item}、{price}。附带动作字段定义对话触发的世界变化（知识传递、好感变化、物品转移等）",

  "templates": {
    "merchant_greeting": {
      "id": "merchant_greeting",
      "类别": "商人问候",
      "适用角色": ["吴平", "云香", "胡倩"],
      "对话列表": [
        "欢迎光临！随便看看~",
        "客官，需要点什么？",
        "今天有新货，进来看看吧！",
        "哎呀，您来了！快请进！",
        "欢迎欢迎，小店蓬荜生辉啊！"
      ]
    },

    "merchant_attract": {
      "id": "merchant_attract",
      "类别": "商人招揽",
      "适用角色": ["吴平", "云香", "胡倩"],
      "对话列表": [
        "走过路过不要错过！",
        "新鲜到货，便宜卖啦！",
        "这位客官，进来看看呗？",
        "今天大促销，不买后悔啊！",
        "瞧一瞧看一看，货真价实！"
      ]
    },

    "fruit_attract": {
      "id": "fruit_attract",
      "类别": "水果店招揽",
      "适用角色": ["吴平"],
      "对话列表": [
        "新鲜的苹果，又大又甜！",
        "今天刚摘的水果，不来点？",
        "苹果便宜卖啦，十文三个！",
        "客官，买个苹果尝尝？",
        "这苹果可甜了，不信你闻闻！"
      ]
    },

    "flower_attract": {
      "id": "flower_attract",
      "类别": "花店招揽",
      "适用角色": ["云香"],
      "对话列表": [
        "漂亮的玫瑰花，送给心上人吧~",
        "今天的花特别新鲜，来看看？",
        "买束花吧，让生活更美好~",
        "这朵玫瑰最适合表白了！",
        "鲜花配美人，不来一束吗？"
      ]
    },

    "clothes_attract": {
      "id": "clothes_attract",
      "类别": "服装店招揽",
      "适用角色": ["胡倩"],
      "对话列表": [
        "新款到货，进来看看吧！",
        "这衣服可适合您了！",
        "今天打折，错过等一年！",
        "客官，试试这件？",
        "布料上乘，做工精细！"
      ]
    },

    "shop_open": {
      "id": "shop_open",
      "类别": "开店",
      "适用角色": ["吴平", "云香", "胡倩"],
      "对话列表": [
        "开门营业啦！",
        "新的一天，新的开始！",
        "小店开张，欢迎惠顾！",
        "来来来，营业啦！"
      ]
    },

    "shop_close": {
      "id": "shop_close",
      "类别": "关店",
      "适用角色": ["吴平", "云香", "胡倩"],
      "对话列表": [
        "打烊啦，明天再来吧！",
        "收工收工，累死了...",
        "关门啦，客官慢走！",
        "今天生意不错，收摊！"
      ]
    },

    "fruit_shop_open": {
      "id": "fruit_shop_open",
      "类别": "水果店开店",
      "适用角色": ["吴平"],
      "对话列表": [
        "水果摊开张！新鲜水果来啦！",
        "早起的鸟儿有虫吃，早起的客官有好果！",
        "今天的苹果特别甜！"
      ]
    },

    "flower_shop_open": {
      "id": "flower_shop_open",
      "类别": "花店开店",
      "适用角色": ["云香"],
      "对话列表": [
        "花店开门啦，香气扑鼻~",
        "今天的玫瑰开得特别好~",
        "来买束花，让心情变好~"
      ]
    },

    "merchant_work": {
      "id": "merchant_work",
      "类别": "商人工作",
      "适用角色": ["吴平", "云香", "胡倩"],
      "对话列表": [
        "(整理货物)",
        "(擦拭柜台)",
        "(盘点库存)",
        "(招呼客人)",
        "(数钱)"
      ]
    },

    "flower_care": {
      "id": "flower_care",
      "类别": "照顾花草",
      "适用角色": ["云香"],
      "对话列表": [
        "(浇花)",
        "(修剪枝叶)",
        "(给花施肥)",
        "(整理花盆)",
        "这些花儿真美~"
      ]
    },

    "greeting_morning": {
      "id": "greeting_morning",
      "类别": "早晨问候",
      "适用角色": ["all"],
      "对话列表": [
        "早啊！",
        "早上好！",
        "今天天气不错！",
        "吃了吗？"
      ]
    },

    "greeting_afternoon": {
      "id": "greeting_afternoon",
      "类别": "下午问候",
      "适用角色": ["all"],
      "对话列表": [
        "下午好！",
      "去哪儿啊？",
        "今天怎么样？",
        "忙完了吗？"
      ]
    },

    "greeting_evening": {
      "id": "greeting_evening",
      "类别": "晚上问候",
      "适用角色": ["all"],
      "对话列表": [
        "晚上好！",
        "吃了晚饭没？",
        "今天累了吧？",
        "早点休息啊！"
      ]
    },

    "reject_gift": {
      "id": "reject_gift",
      "类别": "拒绝礼物",
      "适用角色": ["齐琳琳"],
      "对话列表": [
        "这...不太合适吧。",
        "谢谢，但我不能收。",
        "就这？",
        "你的心意我领了。",
        "我们还是做朋友吧。"
      ],
      "附带动作": {
        "效果": { "记忆标签_送礼者": "被{目标}拒绝礼物", "心情_送礼者": "-3" },
        "好感影响": { "送礼者→目标": "-5" },
        "性格影响_送礼者": { "乐观": -0.03 }
      }
    },

    "accept_gift": {
      "id": "accept_gift",
      "类别": "接受礼物",
      "适用角色": ["all"],
      "对话列表": [
        "谢谢！我很喜欢！",
        "哇，你怎么知道我喜欢这个！",
        "太感谢了！",
        "你真好！",
        "这礼物太棒了！"
      ],
      "附带动作": {
        "效果": { "记忆标签_送礼者": "成功送{目标}礼物", "心情_双方": "+5" },
        "好感影响": { "送礼者→目标": "+20", "目标→送礼者": "+15" }
      }
    },

    "pursuit_confess": {
      "id": "pursuit_confess",
      "类别": "表白",
      "适用角色": ["云飞", "刘坤", "赵六"],
      "对话列表": [
        "我...我喜欢你！",
        "能给我个机会吗？",
        "从见到你的第一眼起，我就...",
        "你愿意做我女朋友吗？",
        "我想和你在一起！"
      ]
    },

    "pursuit_reject": {
      "id": "pursuit_reject",
      "类别": "拒绝表白",
      "适用角色": ["齐琳琳"],
      "对话列表": [
        "对不起，我对你没感觉。",
        "我们还是做朋友吧。",
        "你很好，但不适合我。",
        "我现在不想谈恋爱。",
        "抱歉..."
      ],
      "附带动作": {
        "效果": { "记忆标签_追求者": "被{目标}拒绝表白", "心情_追求者": "-5" },
        "性格影响_追求者": { "乐观": -0.05 },
        "好感影响": { "追求者→目标": "-10" }
      }
    },

    "ask_direction": {
      "id": "ask_direction",
      "类别": "问路",
      "适用角色": ["all"],
      "对话列表": [
        "请问{target}怎么走？",
        "你知道{target}在哪里吗？",
        "能告诉我{target}的方向吗？",
        "我迷路了，请问{target}在哪？"
      ],
      "变量": ["target"],
      "附带动作_回答者": {
        "知道": {
          "效果": { "知识传递": "$回答者知识库.已知地点.{target} → $提问者知识库" },
          "心情影响": { "提问者": "+2（获得信息）" }
        },
        "不知道": {
          "对话": ["不好意思，我也不太清楚。", "我没听说过这个地方。", "你问问别人吧。"],
          "效果": {}
        }
      }
    },

    "give_direction": {
      "id": "give_direction",
      "类别": "指路",
      "适用角色": ["all"],
      "对话列表": [
        "{target}在{direction}，走{distance}就到了。",
        "沿着这条路{direction}走，就是{target}。",
        "{target}啊，往{direction}走{distance}。",
        "我知道，{target}就在{direction}。"
      ],
      "变量": ["target", "direction", "distance"],
      "附带动作": {
        "效果": { "知识传递": "$回答者知识库.已知地点.{target} → $提问者知识库" },
        "好感影响": { "回答者_善良≥6": "+3", "默认": "+1" }
      }
    },

    "idle_thought": {
      "id": "idle_thought",
      "类别": " idle想法",
      "适用角色": ["all"],
      "对话列表": [
        "(发呆)",
        "(叹气)",
        "今天好无聊啊...",
        "接下来干什么呢...",
        "(伸懒腰)"
      ]
    },

    "work_farm": {
      "id": "work_farm",
      "类别": "农田工作",
      "适用角色": ["云飞"],
      "对话列表": [
        "(除草)",
        "(浇水)",
        "(施肥)",
        "庄稼长得不错！",
        "今天要把这片地弄完..."
      ]
    },

    "trade_buy": {
      "id": "trade_buy",
      "类别": "购买",
      "适用角色": ["all"],
      "对话列表": [
        "这个多少钱？",
        "给我来{count}个{item}。",
        "{item}怎么卖？",
        "能便宜点吗？",
        "我买了！"
      ],
      "变量": ["item", "count"],
      "附带动作": {
        "效果": { "物品转移": "$卖家库存.{item} → $买家背包", "金钱转移": "$买家 → $卖家（数量×单价）" },
        "性格影响_购买者": { "大方≥7": "原价购买", "节俭≥7": "尝试砍价" }
      }
    },

    "trade_sell": {
      "id": "trade_sell",
      "类别": "出售",
      "适用角色": ["吴平", "云香", "胡倩"],
      "对话列表": [
        "{item}卖{price}文。",
        "{count}个{item}一共{total}文。",
        "客官，{item}便宜卖！",
        "这是上好的{item}！"
      ],
      "变量": ["item", "price", "count", "total"],
      "附带动作": {
        "效果": { "物品转移": "$卖家库存.{item} → $买家背包", "金钱转移": "$买家 → $卖家（{total}文）" },
        "性格影响_卖家": { "大方≥7": "可能打折", "贪婪≥7": "可能抬价" }
      }
    }
  }
}
