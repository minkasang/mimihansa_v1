      "可重复": true,
      "指令序列": [
        { "module": "move_to", "params": { "target": [47, 14] } },
        { "module": "say", "params": { "text": "这些布料我来搬！", "type": "speak", "duration": 2500 } },
        { "module": "play_animation", "params": { "animation": "walk", "duration": 3000 } },
        { "module": "set_state", "params": { "key": "金钱", "value": 30, "operation": "add" } },
        { "module": "set_state", "params": { "key": "疲劳", "value": 3, "operation": "add" } }
      ]
    },
    {
      "工作id": "job_clean_shop",
      "名称": "打扫店铺",
