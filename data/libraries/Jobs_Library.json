      "可重复": true,
      "指令序列": [
        { "module": "move_to", "params": { "target": [50, 90] } },
        { "module": "say_from_template", "params": { "template_id": "work_farm", "duration": 3000 } },
        { "module": "wait", "params": { "duration": 6000 } },
        { "module": "set_state", "params": { "key": "金钱", "value": 10, "operation": "add" } },
        { "module": "set_state", "params": { "key": "疲劳", "value": 3, "operation": "add" } }
      ]
    }
  ]
