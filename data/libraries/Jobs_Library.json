{
  "_说明": "打工/工作库 - 定义世界中所有可接的工作任务。新增工种只需在此加一条",
  "_版本": "1.0",

  "工作定义": [
    {
      "工作id": "job_harvest_apple",
      "名称": "帮吴平摘苹果",
      "发布者": "吴平",
      "位置": "水果店",
      "需求条件": { "体力": [">", 3] },
      "消耗": { "疲劳": "+2", "时间": 120 },
      "报酬": { "金钱": 15, "好感": { "吴平": 5 } },
      "可重复": true,
      "对话_接取": { "template_id": "trade_buy" },
      "对话_完成": { "template_id": "accept_gift" },
      "指令序列": [
        { "module": "move_to", "params": { "target": [35, 14] } },
        { "module": "say", "params": { "text": "我来帮忙摘苹果！", "type": "speak", "duration": 2500 } },
        { "module": "play_animation", "params": { "animation": "sit", "duration": 4000 } },
        { "module": "wait", "params": { "duration": 4000 } },
        { "module": "set_state", "params": { "key": "金钱", "value": 15, "operation": "add" } },
        { "module": "set_state", "params": { "key": "疲劳", "value": 2, "operation": "add" } }
      ]
    },
    {
      "工作id": "job_carry_goods",
      "名称": "搬运货物",
      "发布者": "胡倩",
      "位置": "衣服店",
      "描述": "帮忙搬运新到的布料",
      "需求条件": { "体力": [">=", 5], "力量": [">=", 4] },
