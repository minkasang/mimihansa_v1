      "位置": "衣服店",
      "描述": "打扫店铺卫生",
      "需求条件": { "体力": [">", 2] },
      "消耗": { "疲劳": "+1", "时间": 30 },
      "报酬": { "金钱": 20, "好感": { "胡倩": 5 } },
      "可重复": true,
      "指令序列": [
        { "module": "move_to", "params": { "target": [47, 14] } },
        { "module": "say", "params": { "text": "我帮你打扫！", "type": "speak", "duration": 2500 } },
        { "module": "play_animation", "params": { "animation": "sit", "duration": 2000 } },
        { "module": "set_state", "params": { "key": "金钱", "value": 20, "operation": "add" } },
        { "module": "set_state", "params": { "key": "疲劳", "value": 1, "operation": "add" } }
      ]
    },
    {
      "工作id": "job_water_flowers",
      "名称": "浇花",
      "发布者": "云香",
      "位置": "花店",
      "描述": "帮忙浇花店的花",
      "需求条件": { "体力": [">", 2] },
      "消耗": { "疲劳": "+1", "时间": 40 },
      "报酬": { "金钱": 10, "好感": { "云香": 8 } },
      "可重复": true,
      "指令序列": [
        { "module": "move_to", "params": { "target": [60, 14] } },
        { "module": "say", "params": { "text": "花儿我来浇！", "type": "speak", "duration": 2500 } },
        { "module": "play_animation", "params": { "animation": "sit", "duration": 2500 } },
        { "module": "set_state", "params": { "key": "金钱", "value": 10, "operation": "add" } },
        { "module": "set_state", "params": { "key": "疲劳", "value": 1, "operation": "add" } }
      ]
    },
    {
      "工作id": "job_farm_work",
      "名称": "农田劳作",
      "发布者": "系统",
      "位置": "麦田",
      "描述": "在农田干活",
      "需求条件": { "体力": [">=", 3] },
      "消耗": { "疲劳": "+3", "时间": 90 },
