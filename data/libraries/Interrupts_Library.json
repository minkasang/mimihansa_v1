{
  "_说明": "中断事件库 - 定义可能打断NPC当前行为的高优先级事件。新增中断类型只需在此加一条",
  "_版本": "1.0",

  "中断定义": [
    {
      "中断id": "interrupt_starvation",
      "类型": "生存威胁",
      "优先级": 10,
      "触发条件": { "生理状态.饥饿": [">=", 9] },
      "反应动作": "action_eat",
      "是否清空当前指令队列": true,
      "说明": "极度饥饿时必须立即找东西吃"
    },
    {
      "中断id": "interrupt_exhaustion",
      "类型": "生存威胁",
      "优先级": 10,
      "触发条件": { "生理状态.疲劳": [">=", 9] },
      "反应动作": "action_sleep",
      "是否清空当前指令队列": true,
      "说明": "极度疲劳时必须立即睡觉"
    },
    {
      "中断id": "interrupt_hunger",
      "类型": "生存威胁",
      "优先级": 8,
      "触发条件": { "生理状态.饥饿": [">=", 8] },
      "反应动作": "action_eat",
      "是否清空当前指令队列": true,
      "说明": "饿了，优先找吃的"
    },
    {
      "中断id": "interrupt_fatigue",
      "类型": "生存威胁",
      "优先级": 7,
      "触发条件": { "生理状态.疲劳": [">=", 8] },
      "反应动作": "action_sleep",
      "是否清空当前指令队列": true,
      "说明": "太困了，需要休息"
    },
    {
      "中断id": "interrupt_storm",
      "类型": "天气中断",
      "优先级": 9,
      "触发条件": {
        "且": [
          { "天气": ["==", "暴雨"] },
          { "是否在室内": ["==", false] }
        ]
      },
      "反应动作": "action_seek_shelter",
      "是否清空当前指令队列": true,
      "说明": "下暴雨了，找建筑躲避"
    },
    {
      "中断id": "interrupt_wild_animal",
      "类型": "生存威胁",
      "优先级": 11,
      "触发条件": {
        "且": [
          { "感知.附近有威胁生物": ["==", true] }
        ]
      },
      "反应动作": "action_flee",
      "是否清空当前指令队列": true,
      "说明": "遇到危险生物，立即逃跑"
    },
    {
      "中断id": "interrupt_high_beauty",
      "类型": "社交感知",
      "优先级": 6,
      "触发条件": {
        "且": [
          { "感知.看到高颜值NPC": ["==", true] },
          { "性格.好色": [">=", 5] }
        ]
      },
      "反应动作": "action_搭讪",
      "是否清空当前指令队列": true,
      "说明": "看到高颜值异性时被吸引，可能会放弃当前正在做的事去搭讪"
    },
    {
      "中断id": "interrupt_fight_start",
      "类型": "战斗",
      "优先级": 11,
      "触发条件": { "感知.附近有战斗": ["==", true] },
      "反应动作": "$根据性格决定",
      "分支": {
        "勇敢>6": "action_参与战斗",
        "谨慎>6": "action_flee",
        "默认": "action_watch"
      },
      "是否清空当前指令队列": true,
      "说明": "附近发生打斗时根据性格决定参与还是逃跑"
    }
  ]
}
