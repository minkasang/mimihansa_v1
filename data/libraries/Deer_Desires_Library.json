          { "NPC.生理状态.饥饿度": [">", 5] },
          {
            "或": [
              { "且": [{ "World.时间.当前小时": [">", 4] }, { "World.时间.当前小时": ["<", 10] }] },
              { "且": [{ "World.时间.当前小时": [">", 15] }, { "World.时间.当前小时": ["<", 21] }] }
            ]
          }
        ]
      },
      "生成目标": { "目标类型": "觅食", "动作id": "action_graze" },
      "效果": { "饥饿": -5 }
    },
    {
      "欲望id": "want_drink",
      "名称": "喝水",
