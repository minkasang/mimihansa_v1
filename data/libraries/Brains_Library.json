{
  "版本": "2.0",
  "描述": "大脑决策系统 - 基于34维性格体系的动态决策引擎",

  "34维性格体系": {
    "说明": "每个NPC拥有完整的34个性格维度，表达在 npc/{角色id}/个人信息.json 的「性格」字段中",
    "维度清单": [
      "乐观", "勤奋", "大方", "谦虚", "好奇", "城府", "勇敢", "理性",
      "善良", "宽容", "忠诚", "冲动", "野心", "社交欲", "嫉妒", "记仇",
      "谨慎", "胆色", "大胆", "道德", "活力", "耐心", "专注", "独立",
      "创造力", "领导力", "适应力", "自律", "敏感", "幽默", "审美", "节俭",
      "竞争欲", "安全感"
    ],
    "商人型使用_性格维度": [
      "情绪基调_积极倾向", "外显活力_行动意愿", "道德水准_利他意愿",
      "财富态度_获取欲望", "财富态度_分享意愿", "胆魄气量_勇气阈值",
      "人际关系_忠诚度", "社交属性_自我坦露"
    ]
  },

  "决策原理": {
    "说明": "每个动作都有性格倾向要求，NPC根据自己的34维性格分数决定是否触发",
    "示例": "追求动作需要 乐观>=6 且 社交欲>=5，张文博满足就会触发，陈德厚不满足就不会触发"
  },

  "动作性格要求": {
    "action_追求": {
      "说明": "主动追求异性",
      "必要条件": {
        "乐观": ">=6",
        "社交欲": ">=5"
      },
      "加分项": {
        "勇敢": ">=6 加20分",
        "大方": ">=7 加15分",
        "冲动": ">=6 加10分"
      },
      "减分项": {
        "谨慎": ">=7 减20分",
        "城府": ">=7 减10分"
      }
    },

    "action_搭讪": {
      "说明": "主动上前对话",
      "必要条件": {
        "社交欲": ">=5"
      },
      "加分项": {
        "乐观": ">=6 加15分",
        "勇敢": ">=5 加10分",
        "幽默": ">=6 加10分"
      },
      "减分项": {
        "谦虚": ">=7 减15分",
        "敏感": ">=7 减10分"
      }
    },

    "action_送礼": {
      "说明": "送礼物给目标",
      "必要条件": {
        "大方": ">=4"
      },
      "加分项": {
        "乐观": ">=6 加10分",
        "勤奋": ">=6 加10分"
      },
      "减分项": {
        "节俭": ">=7 减20分",
        "嫉妒": ">=7 减10分"
      }
    },

    "action_工作": {
      "说明": "执行工作任务",
      "必要条件": {
        "勤奋": ">=4"
      },
      "加分项": {
        "责任心": ">=6 加15分",
        "耐心": ">=6 加10分"
      },
      "减分项": {
        "懒惰": "不存在此维度",
        "娱乐欲": ">=8 减15分"
      }
    },

    "action_逃避": {
      "说明": "遇到挫折后逃避",
      "触发条件": {
        "乐观": "<=4",
        "敏感": ">=7"
      },
      "说明": "悲观且敏感的人容易逃避"
    },

    "action_报复": {
      "说明": "对伤害自己的人报复",
      "触发条件": {
        "记仇": ">=6",
        "冲动": ">=6"
      },
      "抑制条件": {
        "道德": ">=8",
        "宽容": ">=7"
      }
    },

    "action_分享信息": {
      "说明": "回答路人问题",
      "必要条件": {
        "善良": ">=4"
      },
      "加分项": {
        "社交欲": ">=6 加10分",
        "大方": ">=6 加5分"
      }
    },

    "action_greet": {
      "说明": "主动打招呼",
      "必要条件": {
        "社交欲": ">=3"
      },
      "加分项": {
        "乐观": ">=6 加10分",
        "幽默": ">=6 加10分",
        "善良": ">=6 加5分"
      },
      "减分项": {
        "谦虚": ">=7 减10分",
        "城府": ">=7 减5分"
      }
    },

    "action_sunbathe": {
      "说明": "在门口晒太阳放松",
      "必要条件": {
        "乐观": ">=3"
      },
      "加分项": {
        "活力": ">=6 加15分",
        "乐观": ">=7 加10分",
        "耐心": ">=6 加5分"
      },
      "减分项": {
        "勤奋": ">=7 减10分",
        "野心": ">=7 减10分"
      }
    },

    "action_wander": {
      "说明": "无目的闲逛",
      "必要条件": {},
      "所有人都会": true,
      "加分项": {
        "好奇": ">=6 加15分",
        "审美": ">=6 加10分",
        "活力": ">=6 加8分"
      },
      "减分项": {
        "勤奋": ">=8 减10分",
        "自律": ">=7 减10分"
      }
    },

    "action_交易": {
      "说明": "进行商业交易",
      "必要条件": {},
      "所有人都会": true,
      "性格影响": {
        "大方": ">=7 会打折",
        "节俭": ">=7 会砍价",
        "贪婪": ">=7 会抬价"
      }
    }
  },

  "决策流程": {
    "步骤1_感知": "扫描周围环境，发现可交互目标",
    "步骤2_筛选": "根据性格筛选可能触发的动作",
    "步骤3_打分": "对每个可能动作进行效用打分",
    "步骤4_选择": "选择得分最高的动作执行",
    "步骤5_执行": "执行动作，更新状态"
  },

  "效用打分公式": {
    "基础分": "动作定义的基础分数",
    "性格加成": "符合加分项则加分",
    "性格减分": "符合减分项则减分",
    "当前状态": "饥饿、疲劳等状态影响",
    "目标吸引力": "目标的外貌、价值等",
    "最终得分": "基础分 + 性格加成 - 性格减分 + 状态修正 + 目标加成"
  },

  "示例_张文博追求李秀兰": {
    "张文博性格": {
      "乐观": 7,
      "社交欲": 6,
      "勇敢": 5,
      "大方": 5,
      "冲动": 4
    },
    "判断": {
      "必要条件": "乐观7>=6 ✓, 社交欲6>=5 ✓",
      "结论": "可以触发追求动作"
    },
    "效用打分": {
      "基础分": 50,
      "勇敢5>=6": "不满足，不加分",
      "大方5>=7": "不满足，不加分",
      "冲动4>=6": "不满足，不加分",
      "最终": 50
    }
  },

  "示例_陈德厚不追求": {
    "陈德厚性格": {
      "乐观": 5,
      "社交欲": 5
    },
    "判断": {
      "必要条件": "乐观5>=6 ✗",
      "结论": "不满足条件，不会触发追求动作"
    }
  },

