{
  "_说明": "兔子的欲望库。复用人类 GOAP 引擎，6条欲望。全部使用标准字段路径。",
  "_引用": "兔子行为规范.md §四",
  "_字段约定": "NPC.感知结果.{震动感知触发,看到捕食者,闻到捕食者,窝距离} 由感知系统(Step2)写入。",
  "欲望列表": [
    {
      "欲望id": "want_flee",
      "名称": "逃跑",
      "优先级": 10,
      "触发条件": {
        "或": [
          { "NPC.感知结果.震动感知触发": ["==", true] },
          { "NPC.感知结果.看到捕食者": ["==", true] },
          { "NPC.感知结果.闻到捕食者": ["==", true] }
        ]
      },
      "生成目标": { "目标类型": "逃跑", "动作id": "action_flee" }
    },
    {
      "欲望id": "want_eat",
      "名称": "觅食",
      "优先级": 9,
      "触发条件": {
        "且": [
          { "NPC.生理状态.饥饿度": [">", 5] },
          {
            "或": [
              { "且": [{ "World.时间.当前小时": [">", 4] }, { "World.时间.当前小时": ["<", 9] }] },
              { "且": [{ "World.时间.当前小时": [">", 15] }, { "World.时间.当前小时": ["<", 21] }] }
            ]
          }
        ]
      },
      "生成目标": { "目标类型": "觅食", "动作id": "action_forage" },
      "效果": { "饥饿": -4 }
    },
    {
      "欲望id": "want_drink",
      "名称": "喝水",
      "优先级": 8,
      "触发条件": { "NPC.生理状态.口渴度": [">", 6] },
      "生成目标": { "目标类型": "移动", "动作id": "action_go_to_water" },
      "效果": { "口渴": -5 }
    },
    {
      "欲望id": "want_nurse_kits",
      "名称": "喂幼崽",
      "优先级": 7,
      "触发条件": {
        "且": [
          { "NPC.动物数据.带幼崽": ["==", true] },
          { "NPC.感知结果.窝距离": ["<", 15] },
          { "World.时间.当前小时": [">", 4] },
          { "World.时间.当前小时": ["<", 21] }
        ]
      },
      "生成目标": { "目标类型": "照顾", "动作id": "action_nurse_kits" },
      "效果": { "幼崽.饥饿": -3 }
    },
    {
      "欲望id": "want_sleep",
      "名称": "睡觉",
      "优先级": 5,
      "触发条件": {
        "且": [
          { "NPC.生理状态.疲劳度": [">", 7] },
          { "NPC.感知结果.窝距离": ["<", 20] }
        ]
      },
      "生成目标": { "目标类型": "休息", "动作id": "action_sleep" },
      "效果": { "疲劳": -4 }
    },
    {
      "欲望id": "want_hide",
      "名称": "躲藏",
      "优先级": 2,
      "触发条件": {},
      "生成目标": { "目标类型": "躲藏", "动作id": "action_hide" }
    }
  ]
}
