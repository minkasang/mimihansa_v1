{
  "_说明": "狼的欲望库。复用人类 GOAP 引擎，7条欲望。全部使用标准字段路径。",
  "_引用": "狼群行为规范.md §五",
  "_字段约定": "NPC.动物数据.{角色,进食顺序,距上次巡逻} 由动物推进(Step2.5)维护。NPC.感知结果.{xxx} 由感知系统(Step2)写入。",
  "欲望列表": [
    {
      "欲望id": "want_eat_from_kill",
      "名称": "进食（从尸体）",
      "优先级": 10,
      "触发条件": {
        "且": [
          { "附近有": "动物尸体" },
          { "NPC.动物数据.进食顺序": ["已到我"] }
        ]
      },
      "生成目标": { "目标类型": "进食", "动作id": "action_eat" },
      "效果": { "饥饿": -6, "开心": 2 }
    },
    {
      "欲望id": "want_hunt",
      "名称": "狩猎",
      "优先级": 9,
      "触发条件": {
        "或": [
          {
            "且": [
              { "NPC.动物数据.角色": ["==", "首领"] },
              { "World.时间.当前小时": [">", 5] },
              { "World.时间.当前小时": ["<", 9] }
            ]
          },
          {
            "且": [
              { "NPC.生理状态.饥饿度": [">", 5] },
              { "NPC.感知结果.附近有猎物": ["==", true] }
            ]
          }
        ]
      },
      "生成目标": { "目标类型": "狩猎", "动作id": "action_hunt_pack" }
    },
    {
      "欲望id": "want_drink",
      "名称": "喝水",
      "优先级": 8,
      "触发条件": { "NPC.生理状态.口渴度": [">", 6] },
      "生成目标": { "目标类型": "移动", "动作id": "action_go_to_water" },
      "效果": { "口渴": -5 }
    },
    {
      "欲望id": "want_sleep",
      "名称": "睡觉",
      "优先级": 6,
      "触发条件": {
        "且": [
          { "NPC.生理状态.疲劳度": [">", 7] },
          {
            "或": [
              { "NPC.感知结果.巢穴距离": ["<", 50] },
              { "标签": ["有标签", "在安全区域"] }
            ]
          }
        ]
      },
      "生成目标": { "目标类型": "休息", "动作id": "action_sleep" },
      "效果": { "疲劳": -4 }
    },
    {
      "欲望id": "want_howl",
      "名称": "嚎叫",
      "优先级": 5,
      "触发条件": {
        "或": [
          { "NPC.感知结果.同群距离": [">", 30] },
          {
            "且": [
              { "NPC.感知结果.发现大型猎物": ["==", true] },
              { "NPC.感知结果.附近同群数量": ["<", 3] }
            ]
          }
        ]
      },
      "生成目标": { "目标类型": "通讯", "动作id": "action_howl" }
    },
    {
      "欲望id": "want_follow_leader",
      "名称": "跟随首领",
      "优先级": 4,
      "触发条件": {
        "且": [
          { "NPC.动物数据.角色": ["!=", "首领"] },
          { "NPC.感知结果.首领在移动": ["==", true] }
        ]
      },
      "生成目标": { "目标类型": "移动", "动作id": "action_follow" }
    },
    {
      "欲望id": "want_patrol",
      "名称": "巡逻领地",
      "优先级": 3,
      "触发条件": {
        "且": [
          { "NPC.生理状态.饥饿度": ["<", 5] },
          { "NPC.生理状态.疲劳度": ["<", 6] },
          { "NPC.动物数据.距上次巡逻": [">", 43200] }
        ]
      },
      "生成目标": { "目标类型": "巡逻", "动作id": "action_patrol" }
    },
    {
      "欲望id": "want_wander",
      "名称": "游荡",
      "优先级": 1,
      "触发条件": {},
      "生成目标": { "目标类型": "移动", "动作id": "action_wander" }
    }
  ]
}
